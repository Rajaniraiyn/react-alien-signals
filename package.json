{
  "name": "react-alien-signals",
  "version": "0.3.0",
  "packageManager": "bun@1.3.14",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rajaniraiyn/react-alien-signals.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "build": "bun run scripts/build.ts",
    "docs": "typedoc src/index.ts",
    "docs:preview": "bun run docs && npx serve docs"
  },
  "dependencies": {},
  "devDependencies": {
    "@happy-dom/global-registrator": "^17.1.3",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/bun": "^1.2.3",
    "@types/react": "^19.0.10",
    "react-dom": "^19.0.0",
    "typedoc": "^0.28.20",
    "typescript": "^5.7.3"
  },
  "peerDependencies": {
    "alien-signals": "~1.0.4",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": false
    },
    "alien-signals": {
      "optional": false
    }
  },
  "workspaces": [
    "playground"
  ]
}
